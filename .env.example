# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# Neon PostgreSQL (required in production)
DATABASE_URL=

# Comma-separated allowed frontend origins (Vercel URL)
FRONTEND_URL=http://localhost:3000

# Auth
TEACHER_LOGIN_CODE=change-me-to-a-strong-secret
SESSION_SECRET=change-me-long-random-string

# Cloudflare R2 (required in production for media)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Optional
AI_API_KEY=
PGSSL=
PG_POOL_MAX=10
