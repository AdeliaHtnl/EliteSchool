# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# Neon PostgreSQL (required in production)
DATABASE_URL=

# Comma-separated allowed frontend origins (Vercel URL in production)
FRONTEND_URL=http://localhost:3000

# Auth
TEACHER_LOGIN_CODE=change-me-to-a-strong-secret
SESSION_SECRET=change-me-long-random-string

# Cloudflare R2 (required in production for lesson videos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public CDN/base URL for objects (optional if using signed GET only)
R2_PUBLIC_URL=

# Max lesson video size in megabytes (default 5120 = 5 GB)
MAX_VIDEO_SIZE_MB=5120

# Optional retelling upload cap via Express body (MB)
MAX_RETELL_UPLOAD_MB=400

# Optional
AI_API_KEY=
PGSSL=
PG_POOL_MAX=10
